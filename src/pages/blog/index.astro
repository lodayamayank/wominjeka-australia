---
import Base from '../../layouts/Base.astro';
import { decode, getCategories, getPosts } from '../../lib/wp.js';

const [posts, categories] = await Promise.all([getPosts(), getCategories()]);
---

<Base title="Blog">
	<h1>Blog</h1>
	{categories.length > 0 && (
		<nav aria-label="Blog categories">
			<ul>
				{categories.map((category) => (
					<li><a href={`/blog/category/${category.slug}/`}>{decode(category.name) || category.slug}</a></li>
				))}
			</ul>
		</nav>
	)}
	{posts.length ? (
		<ul>
			{posts.map((post) => <li><a href={`/blog/${post.slug}/`}>{decode(post.title?.rendered) || post.slug}</a></li>)}
		</ul>
	) : <p>No posts yet.</p>}
</Base>
