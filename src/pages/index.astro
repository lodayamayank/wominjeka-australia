---
import Base from '../layouts/Base.astro';
import { decode, getPages } from '../lib/wp.js';

const pages = await getPages();
const home = pages.find(({ slug }) => slug === 'home');
const links = pages.filter(({ slug }) => slug && !['home', 'blog', '404'].includes(slug));
---

<Base title="Wominjeka Australia">
	<h1>{decode(home?.title?.rendered) || 'Wominjeka Australia'}</h1>
	{home?.content?.rendered && <Fragment set:html={home.content.rendered} />}
	{links.length > 0 && (
		<ul>
			{links.map((page) => <li><a href={`/${page.slug}/`}>{decode(page.title?.rendered) || page.slug}</a></li>)}
		</ul>
	)}
</Base>
